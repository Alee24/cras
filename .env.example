# ==============================================================================
# COMPLIANCE RISK ANALYTICS SYSTEM (CRAS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
FLASK_APP=wsgi.py
FLASK_ENV=production
DEBUG=False
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# ==============================================================================
# DATABASE CONFIGURATION (SQLITE IS DEFAULT)
# ==============================================================================
# OPTION 1: SQLite (DEFAULT - Easy, zero-config, portable)
# To change the SQLite database file name or path, simply modify this line:
DATABASE_URL=sqlite:///instance/cras.db

# OPTION 2: PostgreSQL (Uncomment and edit below if deploying with PostgreSQL)
# DATABASE_URL=postgresql://cras_user:cras_secure_password_2026@localhost:5432/cras_db

# ==============================================================================
# FILE UPLOADS
# ==============================================================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ==============================================================================
# SYSTEM INITIAL ADMINISTRATOR CREDENTIALS
# ==============================================================================
INITIAL_ADMIN_EMAIL=admin@cras.ke
INITIAL_ADMIN_PASSWORD=Admin@CRAS2026!
INITIAL_ADMIN_NAME="System Administrator"

# ==============================================================================
# SECURITY & SESSION SETTINGS
# ==============================================================================
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=28800

# ==============================================================================
# EMAIL CONFIGURATION (OPTIONAL / SMTP)
# ==============================================================================
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@cras.ke

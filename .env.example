# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=production
DEBUG=False
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# Database Configuration
# Local SQLite fallback: sqlite:///instance/cras.db
# Production PostgreSQL: postgresql://cras_user:cras_password@postgres:5432/cras_db
DATABASE_URL=sqlite:///instance/cras.db

# Security & Session Settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=28800

# File Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# System Initial Admin (Seed Configuration)
INITIAL_ADMIN_EMAIL=admin@cras.ke
INITIAL_ADMIN_PASSWORD=Admin@CRAS2026!
INITIAL_ADMIN_NAME="System Administrator"

# Email Configuration (Optional / SMTP)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@cras.ke
